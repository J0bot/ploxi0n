{
  "appId": "ch.j0bot.ploxi0n",
  "appName": "ploxi0n",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#07050c",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK"
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true,
      "backgroundColor": "#07050c"
    },
    "CapacitorSQLite": {
      "iosDatabaseLocation": "Library/CapacitorDatabase",
      "iosIsEncryption": false,
      "iosKeychainPrefix": "ploxi0n",
      "iosBiometric": {
        "biometricAuth": false
      }
    },
    "PushNotifications": {
      "presentationOptions": [
        "list",
        "badge"
      ]
    }
  },
  "android": {
    "backgroundColor": "#07050c"
  }
}
