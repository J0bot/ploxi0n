{
  "name": "ploxi0n",
  "version": "0.99.63",
  "private": true,
  "type": "module",
  "description": "ploxi0n v1 : les ploxions du xerboxion sur iOS, 100 % hors ligne (Capacitor + boxion_local)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "extraire": "node tools/extraire-ploxions.mjs",
    "audit": "node tools/audit-ploxions.mjs",
    "test": "node --test tests/*.test.mjs",
    "rust": "node tools/rust.mjs",
    "digerer": "node tools/digestion/recolter.mjs && rust/target/release/digerer build/digestion/ploxions build/digestion/digestion.json docs/DIGESTION-ETAT.md",
    "faux-iphone": "node tools/faux-iphone/faux-iphone.mjs http://localhost:4173/ build/faux-iphone --script tools/faux-iphone/parcours-app.mjs",
    "sync": "npx cap sync ios",
    "postinstall": "node tools/spm-capacitor8.mjs"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/motion": "^8.0.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-app-shortcuts": "^8.0.3",
    "@capgo/capacitor-health": "^8.11.8",
    "@capgo/capacitor-native-biometric": "^8.8.1",
    "@capgo/capacitor-nfc": "^8.3.0",
    "@capgo/capacitor-wifi": "^8.5.6",
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "vite": "^8.3.4"
  }
}
