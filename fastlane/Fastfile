# ploxi0n — le build TestFlight (brief v1). Appelé par .github/workflows/ios.yml ; les secrets viennent de GitHub, jamais du dépôt.
default_platform(:ios)

PROJET = "ios/App/App.xcodeproj"
APP_ID = "ch.j0bot.ploxi0n"

# un appel à l'API publique d'App Store Connect, avec le jeton de la clé API (app_store_connect_api_key doit avoir tourné)
def asc(methode, chemin, corps = nil)
  require "net/http"
  require "json"
  uri = URI("https://api.appstoreconnect.apple.com/v1/#{chemin}")
  req = (methode == :get ? Net::HTTP::Get : Net::HTTP::Post).new(uri)
  req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
  req["Content-Type"] = "application/json"
  req.body = corps.to_json if corps
  r = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |h| h.request(req) }
  d = r.body.to_s.strip.empty? ? {} : JSON.parse(r.body)
  raise("HTTP #{r.code} : #{(d['errors'] || []).map { |e| e['detail'] }.join(' ; ')}") unless r.code.to_i.between?(200, 299)
  d
end

WID_ID = "#{APP_ID}.widgets"
WIDGETS = ENV["PLOXI0N_WIDGETS"] == "1"
VLC = ENV["PLOXI0N_VLC"] == "1"   # le lecteur VLC (0.49) : sans lui, le lecteur intégré n'a que le moteur d'Apple   # l'interrupteur des widgets : sans lui, le build est exactement celui d'avant

# Les WIDGETS (ios/App/PloxionWidgets) : la cible d'extension est ajoutée au projet ICI, sur le Mac de la CI (gem xcodeproj, livrée avec
# fastlane), jamais à la main dans le .pbxproj ; idempotent. Elle est embarquée dans l'app (PlugIns), même version et même build.
def ajouter_widgets
  require "xcodeproj"
  projet = Xcodeproj::Project.open(File.expand_path("../#{PROJET}", __dir__))
  return UI.message("cible PloxionWidgets déjà là") if projet.targets.any? { |t| t.name == "PloxionWidgets" }
  app = projet.targets.find { |t| t.name == "App" }
  version = app.build_configurations.first.build_settings["MARKETING_VERSION"] || "1.0"
  build = app.build_configurations.first.build_settings["CURRENT_PROJECT_VERSION"] || "1"
  cible = projet.new_target(:app_extension, "PloxionWidgets", :ios, "17.0", nil, :swift)
  groupe = projet.main_group.new_group("PloxionWidgets", "PloxionWidgets")
  cible.add_file_references([groupe.new_reference("PloxionWidgets.swift")])
  groupe.new_reference("Info.plist")
  groupe.new_reference("PloxionWidgets.entitlements")
  cible.add_system_frameworks(%w[WidgetKit SwiftUI])
  cible.build_configurations.each do |c|
    c.build_settings.merge!(
      "PRODUCT_BUNDLE_IDENTIFIER" => WID_ID, "PRODUCT_NAME" => "PloxionWidgets", "INFOPLIST_FILE" => "PloxionWidgets/Info.plist",
      "CODE_SIGN_ENTITLEMENTS" => "PloxionWidgets/PloxionWidgets.entitlements", "SWIFT_VERSION" => "5.0", "TARGETED_DEVICE_FAMILY" => "1,2",
      "IPHONEOS_DEPLOYMENT_TARGET" => "17.0", "MARKETING_VERSION" => version, "CURRENT_PROJECT_VERSION" => build,
      "GENERATE_INFOPLIST_FILE" => "NO", "SKIP_INSTALL" => "YES", "DEVELOPMENT_TEAM" => ENV["APPLE_TEAM_ID"],
      "LD_RUNPATH_SEARCH_PATHS" => ["$(inherited)", "@executable_path/Frameworks", "@executable_path/../../Frameworks"]
    )
  end
  app.add_dependency(cible)
  embarquer = app.new_copy_files_build_phase("Embed Foundation Extensions")
  embarquer.symbol_dst_subfolder_spec = :plug_ins
  embarquer.add_file_reference(cible.product_reference).settings = { "ATTRIBUTES" => ["RemoveHeadersOnCopy"] }
  projet.save
  UI.success("cible PloxionWidgets ajoutée (#{WID_ID}, #{version} (#{build}))")
end

# Le MANIFESTE DE CONFIDENTIALITÉ (0.47, exigé par Apple : UserDefaults, espace disque) : ios/App/App/PrivacyInfo.xcprivacy, ajouté aux
# ressources de l'app ICI (gem xcodeproj), idempotent — comme les widgets, jamais à la main dans le .pbxproj.
def ajouter_confidentialite
  require "xcodeproj"
  projet = Xcodeproj::Project.open(File.expand_path("../#{PROJET}", __dir__))
  app = projet.targets.find { |t| t.name == "App" }
  return UI.message("PrivacyInfo.xcprivacy déjà dans l'app") if app.resources_build_phase.files_references.any? { |r| r && r.path.to_s.end_with?("PrivacyInfo.xcprivacy") }
  groupe = projet.main_group.children.find { |g| g.respond_to?(:path) && g.path == "App" } || projet.main_group
  ref = groupe.files.find { |r| r.path == "PrivacyInfo.xcprivacy" } || groupe.new_reference("PrivacyInfo.xcprivacy")
  app.add_resources([ref])
  projet.save
  UI.success("PrivacyInfo.xcprivacy ajouté aux ressources de l'app")
end

# (0.99.23) LES LANGUES des autorisations d'iOS : ios/App/App/<langue>.lproj/InfoPlist.strings (tools/ios/infoplist-langues.mjs) ajoutés aux
# ressources de l'app ICI (gem xcodeproj), en un groupe de variantes « InfoPlist.strings », idempotent. Rattrapé : si la gem refuse, le build
# continue sans (les autorisations restent en français), jamais un build cassé pour ça.
LANGUES_IOS = %w[fr en de it es]
def ajouter_langues
  require "xcodeproj"
  projet = Xcodeproj::Project.open(File.expand_path("../#{PROJET}", __dir__))
  app = projet.targets.find { |t| t.name == "App" }
  return UI.message("InfoPlist.strings déjà dans l'app") if app.resources_build_phase.files_references.any? { |r| r && r.respond_to?(:name) && r.name == "InfoPlist.strings" }
  groupe = projet.main_group.children.find { |g| g.respond_to?(:path) && g.path == "App" } || projet.main_group
  variantes = groupe.new_variant_group("InfoPlist.strings")
  LANGUES_IOS.each do |l|
    next unless File.exist?(File.expand_path("../ios/App/App/#{l}.lproj/InfoPlist.strings", __dir__))
    ref = variantes.new_reference("#{l}.lproj/InfoPlist.strings")
    ref.name = l
  end
  app.add_resources([variantes])
  projet.root_object.known_regions = (projet.root_object.known_regions + LANGUES_IOS).uniq
  projet.save
  UI.success("InfoPlist.strings (#{LANGUES_IOS.join(', ')}) ajoutés aux ressources de l'app")
rescue StandardError => e
  UI.important("les langues des autorisations ne sont pas ajoutées (#{e.message}) : le build continue, les autorisations restent en français")
end

# Le LECTEUR VLC (0.49, option PLOXI0N_VLC) : le paquet SPM vlckit-spm (MobileVLCKit, LGPL) ajouté à la cible App ICI (gem xcodeproj),
# idempotent. Le Swift (PloxiLecteur, EcranVLC) est entre #if canImport(MobileVLCKit) : sans le paquet, il n'est pas compilé.
VLC_PAQUET = "https://github.com/tylerjonesio/vlckit-spm"
def ajouter_vlc
  require "xcodeproj"
  projet = Xcodeproj::Project.open(File.expand_path("../#{PROJET}", __dir__))
  app = projet.targets.find { |t| t.name == "App" }
  return UI.message("VLC déjà dans l'app") if app.package_product_dependencies.any? { |d| d.product_name == "VLCKitSPM" }
  paquet = projet.root_object.package_references.find { |p| p.respond_to?(:repositoryURL) && p.repositoryURL == VLC_PAQUET }
  unless paquet
    paquet = projet.new(Xcodeproj::Project::Object::XCRemoteSwiftPackageReference)
    paquet.repositoryURL = VLC_PAQUET
    paquet.requirement = { "kind" => "upToNextMajorVersion", "minimumVersion" => "3.6.0" }
    projet.root_object.package_references << paquet
  end
  dep = projet.new(Xcodeproj::Project::Object::XCSwiftPackageProductDependency)
  dep.package = paquet
  dep.product_name = "VLCKitSPM"
  app.package_product_dependencies << dep
  fichier = projet.new(Xcodeproj::Project::Object::PBXBuildFile)
  fichier.product_ref = dep
  app.frameworks_build_phase.files << fichier
  projet.save
  UI.success("VLC ajouté à l'app (#{VLC_PAQUET})")
end

# L'AR NATIVE (0.73, PloxiAR dans AppDelegate.swift : ARKit, RealityKit, RoomPlan) est dans CHAQUE build. Interrupteur de secours, si un
# Xcode la refusait un jour : PLOXI0N_AR=0 → la condition de compilation PLOXI0N_SANS_AR sur la cible App (gem xcodeproj, sur le Mac de la
# CI) : PloxiAR n'est pas compilé, le terrax garde son AR web.
SANS_AR = ENV["PLOXI0N_AR"] == "0"
def retirer_ar
  require "xcodeproj"
  projet = Xcodeproj::Project.open(File.expand_path("../#{PROJET}", __dir__))
  app = projet.targets.find { |t| t.name == "App" }
  app.build_configurations.each do |c|
    v = c.build_settings["SWIFT_ACTIVE_COMPILATION_CONDITIONS"]
    l = v.is_a?(Array) ? v : v.to_s.split(" ")
    l = ["$(inherited)"] if l.empty?
    c.build_settings["SWIFT_ACTIVE_COMPILATION_CONDITIONS"] = (l + ["PLOXI0N_SANS_AR"]).uniq.join(" ")
  end
  projet.save
  UI.important("l'AR native retirée de ce build (PLOXI0N_AR=0)")
end

# (0.99.24) LE MAILLAGE EN BLUETOOTH BASSE CONSOMMATION (PloxiBLE dans AppDelegate.swift, derrière #if PLOXI0N_BLE) : PLOXI0N_BLE=1 → la
# condition de compilation sur la cible App, et le mode d'arrière-plan bluetooth-peripheral dans Info.plist (gem xcodeproj, sur le Mac de
# la CI). Sans l'option, le build est exactement celui d'avant : le Swift du BLE n'est même pas compilé.
BLE = ENV["PLOXI0N_BLE"] == "1"
def ajouter_ble
  require "xcodeproj"
  projet = Xcodeproj::Project.open(File.expand_path("../#{PROJET}", __dir__))
  app = projet.targets.find { |t| t.name == "App" }
  app.build_configurations.each do |c|
    v = c.build_settings["SWIFT_ACTIVE_COMPILATION_CONDITIONS"]
    l = v.is_a?(Array) ? v : v.to_s.split(" ")
    l = ["$(inherited)"] if l.empty?
    c.build_settings["SWIFT_ACTIVE_COMPILATION_CONDITIONS"] = (l + ["PLOXI0N_BLE"]).uniq.join(" ")
  end
  projet.save
  plist = File.expand_path("../ios/App/App/Info.plist", __dir__)
  info = Xcodeproj::Plist.read_from_path(plist)
  info["UIBackgroundModes"] = ((info["UIBackgroundModes"] || []) + ["bluetooth-central", "bluetooth-peripheral"]).uniq
  Xcodeproj::Plist.write_to_path(info, plist)
  UI.success("le maillage BLE compilé (PLOXI0N_BLE), en arrière-plan : #{info["UIBackgroundModes"].join(', ')}")
end

# l'identifiant des widgets sur le compte développeur, avec App Groups (le GROUPE lui-même s'assigne dans le portail : l'API ne le permet pas)
def identifiant_widgets
  bid = asc(:get, "bundleIds?filter[identifier]=#{WID_ID}")["data"].first
  bid ||= asc(:post, "bundleIds", { data: { type: "bundleIds", attributes: { identifier: WID_ID, name: "ploxi0n widgets", platform: "IOS" } } })["data"]
  begin
    asc(:post, "bundleIdCapabilities", { data: { type: "bundleIdCapabilities", attributes: { capabilityType: "APP_GROUPS" },
                                                relationships: { bundleId: { data: { type: "bundleIds", id: bid["id"] } } } } })
  rescue => e
    UI.message("App Groups sur #{WID_ID} : #{e.message} (déjà là ?)")
  end
end

platform :ios do
  desc "Construit l'app et l'envoie sur TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_P8 APPLE_TEAM_ID].each { |k| UI.user_error!("secret GitHub manquant : #{k}") if ENV[k].to_s.empty? }
    cle = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_P8"], in_house: false)
    # un numéro de build unique à chaque envoi (TestFlight refuse un doublon ou un numéro plus bas) : le dernier de TestFlight + 1 —
    # GitHub Actions et Codemagic (0.49, docs/TESTFLIGHT.md) peuvent alterner sans se marcher dessus
    dernier = begin
      latest_testflight_build_number(api_key: cle, app_identifier: APP_ID, initial_build_number: 0).to_i
    rescue => e
      UI.important("dernier build TestFlight illisible (#{e.message}) : le numéro de la CI")
      0
    end
    numero = [dernier + 1, (ENV["GITHUB_RUN_NUMBER"] || ENV["BUILD_NUMBER"] || 0).to_i].max
    increment_build_number(xcodeproj: PROJET, build_number: numero.to_s)
    begin
      ajouter_confidentialite
      ajouter_langues
    rescue => e   # jamais bloquant : sans manifeste, TestFlight accepte le build (Apple prévient par e-mail, ITMS-91053)
      UI.important("PrivacyInfo.xcprivacy pas ajouté : #{e.message}")
    end
    ajouter_vlc if VLC
    retirer_ar if SANS_AR
    ajouter_ble if BLE
    if WIDGETS
      ajouter_widgets
      identifiant_widgets
    end
    ids = WIDGETS ? [APP_ID, WID_ID] : APP_ID

    if ENV["MATCH_GIT_URL"].to_s.empty?
      # signature gérée par Apple (cloud-managed) : xcodebuild s'authentifie avec la clé API, aucun dépôt de certificats
      chemin_cle = File.join(Dir.tmpdir, "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
      File.write(chemin_cle, ENV["ASC_KEY_P8"])
      auth = "-allowProvisioningUpdates -authenticationKeyPath #{chemin_cle} -authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
      update_code_signing_settings(path: PROJET, use_automatic_signing: true, team_id: ENV["APPLE_TEAM_ID"], targets: WIDGETS ? ["App", "PloxionWidgets"] : ["App"])
      build_app(project: PROJET, scheme: "App", configuration: "Release", output_directory: "build",
                export_method: "app-store", xcargs: auth, export_xcargs: auth,
                export_options: { signingStyle: "automatic", teamID: ENV["APPLE_TEAM_ID"] })
    else
      # match : le certificat de distribution et le profil App Store sont créés UNE fois (avec la clé API), chiffrés dans le dépôt privé
      # ploxi0n-certificats, puis réutilisés ; un profil App Store n'exige aucun appareil enregistré
      match(type: "appstore", readonly: false, api_key: cle, app_identifier: ids, git_url: ENV["MATCH_GIT_URL"],
            team_id: ENV["APPLE_TEAM_ID"], keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
            force: ENV["MATCH_FORCE"] == "true")   # MATCH_FORCE : régénérer le profil quand les capabilities de l'identifiant changent
      profil = ENV["sigh_#{APP_ID}_appstore_profile-name"]
      update_code_signing_settings(path: PROJET, use_automatic_signing: false, team_id: ENV["APPLE_TEAM_ID"], targets: ["App"],
                                   code_sign_identity: "Apple Distribution", profile_name: profil, build_configurations: ["Release"])
      profils = { APP_ID => profil }
      if WIDGETS
        profils[WID_ID] = ENV["sigh_#{WID_ID}_appstore_profile-name"]
        update_code_signing_settings(path: PROJET, use_automatic_signing: false, team_id: ENV["APPLE_TEAM_ID"], targets: ["PloxionWidgets"],
                                     code_sign_identity: "Apple Distribution", profile_name: profils[WID_ID], build_configurations: ["Release"])
      end
      build_app(project: PROJET, scheme: "App", configuration: "Release", output_directory: "build", export_method: "app-store",
                export_options: { signingStyle: "manual", teamID: ENV["APPLE_TEAM_ID"], provisioningProfiles: profils })
    end

    upload_to_testflight(api_key: cle, skip_waiting_for_build_processing: true)
    testeurs_internes
  end

  # Le groupe de testeurs internes « ploxi0n interne » reçoit AUTOMATIQUEMENT chaque build (pas d'attente du traitement d'Apple,
  # donc pas de minutes macOS perdues) ; TESTFLIGHT_EMAIL (secret, l'Apple ID de RS-7) y est ajouté et invité (betaTesterInvitations).
  # Jamais bloquant : un échec ici n'annule pas le build envoyé.
  desc "Affiche les capabilities activées sur l'identifiant de l'app (sans build : tourne sur Linux)"
  desc "Envoie les métadonnées de l'App Store (fastlane/metadata : textes, catégories, URLs, notes de revue) — sans binaire ni captures"
  lane :metadonnees do
    cle = app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_P8"], in_house: false)
    deliver(api_key: cle, app_identifier: APP_ID, metadata_path: File.expand_path("metadata", __dir__), skip_binary_upload: true, skip_screenshots: true,
            submit_for_review: false, force: true, run_precheck_before_submit: false, precheck_include_in_app_purchases: false)
  end

  lane :capabilities do
    app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_P8"], in_house: false)
    bid = asc(:get, "bundleIds?filter[identifier]=#{APP_ID}")["data"].first || UI.user_error!("identifiant #{APP_ID} introuvable")
    caps, chemin = [], "bundleIds/#{bid['id']}/bundleIdCapabilities"
    while chemin
      page = asc(:get, chemin)
      caps += page["data"].map { |c| c["attributes"]["capabilityType"] + (c["attributes"]["settings"].to_a.empty? ? "" : " #{c['attributes']['settings'].map { |x| x['options'].to_a.select { |o| o['enabled'] }.map { |o| o['key'] } }.flatten.join('/')}") }
      suivant = page.dig("links", "next")
      chemin = suivant ? suivant.sub("https://api.appstoreconnect.apple.com/v1/", "") : nil
    end
    caps.sort!
    UI.success("#{caps.size} capabilities sur #{APP_ID} : #{caps.join(', ')}")
  end

  desc "Les plantages partagés depuis TestFlight (12.10 : « ça crash quand j'ouvre ») : les 8 derniers, avec le début de leur journal"
  lane :crashs do
    app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_P8"], in_house: false)
    app = asc(:get, "apps?filter[bundleId]=#{APP_ID}")["data"].first || UI.user_error!("app #{APP_ID} absente")
    l = asc(:get, "apps/#{app['id']}/betaFeedbackCrashSubmissions?limit=8&sort=-createdDate")["data"] rescue (UI.important("API des plantages indisponible : #{$!.message}"); [])
    UI.message("#{l.size} plantage(s) partagé(s)")
    l.each do |c|
      a = c["attributes"] || {}
      UI.header("#{a['createdDate']} · #{a['deviceModel']} · iOS #{a['osVersion']} · build #{a['buildBundleId']} — #{a['comment']}")
      begin
        log = asc(:get, "betaFeedbackCrashSubmissions/#{c['id']}/crashLog").dig("data", "attributes", "logText").to_s
        puts log.lines.first(90).join
      rescue => e
        UI.important("journal : #{e.message}")
      end
    end
  end

  desc "Crée le groupe de testeurs internes et invite TESTFLIGHT_EMAIL (sans build : tourne sur Linux)"
  lane :testeurs do
    app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_content: ENV["ASC_KEY_P8"], in_house: false)
    testeurs_internes
  end

  private_lane :testeurs_internes do
    email = ENV["TESTFLIGHT_EMAIL"].to_s
    next UI.important("TESTFLIGHT_EMAIL absent : personne à inviter") if email.empty?
    etape = lambda do |nom, &bloc|
      begin
        r = bloc.call
        UI.success(nom)
        r
      rescue => e
        UI.important("#{nom} : #{e.message} (le build n'est pas touché)")
        nil
      end
    end
    app = etape.call("app trouvée") { asc(:get, "apps?filter[bundleId]=#{APP_ID}")["data"].first || raise("app #{APP_ID} absente d'App Store Connect") }
    next unless app
    groupe = etape.call("groupe « ploxi0n interne » prêt (il reçoit chaque build)") do
      asc(:get, "betaGroups?filter[app]=#{app['id']}&filter[name]=#{URI.encode_www_form_component('ploxi0n interne')}")["data"].first ||
        asc(:post, "betaGroups", { data: { type: "betaGroups", attributes: { name: "ploxi0n interne", isInternalGroup: true, hasAccessToAllBuilds: true },
                                          relationships: { app: { data: { type: "apps", id: app["id"] } } } } })["data"]
    end
    next unless groupe
    testeur = etape.call("testeur dans le groupe") do
      t = asc(:get, "betaTesters?filter[email]=#{URI.encode_www_form_component(email)}")["data"].first
      if t
        asc(:post, "betaGroups/#{groupe['id']}/relationships/betaTesters", { data: [{ type: "betaTesters", id: t["id"] }] })
        t
      else
        asc(:post, "betaTesters", { data: { type: "betaTesters", attributes: { email: email, firstName: "RS", lastName: "7" },
                                           relationships: { betaGroups: { data: [{ type: "betaGroups", id: groupe["id"] }] } } } })["data"]
      end
    end
    next unless testeur
    etape.call("invitation TestFlight envoyée") do
      asc(:post, "betaTesterInvitations", { data: { type: "betaTesterInvitations",
                                                   relationships: { app: { data: { type: "apps", id: app["id"] } }, betaTester: { data: { type: "betaTesters", id: testeur["id"] } } } } })
    end
  end
end
