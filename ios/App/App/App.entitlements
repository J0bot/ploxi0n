<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Data Protection « Complete » : les fichiers de l'app (dont la base boxion_local) sont chiffrés par iOS quand l'iPhone est verrouillé -->
	<key>com.apple.developer.default-data-protection</key>
	<string>NSFileProtectionComplete</string>
	<!-- HealthKit (lecture, sur accord) -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- NFC : lire des tags -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!-- le nom du réseau Wi-Fi -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<!-- App Groups : l'app et ses widgets partagent leurs données -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.ch.j0bot.ploxi0n</string>
	</array>
	<!-- Sign in with Apple : un compte bion (le serveur du labo vérifie le jeton d'Apple) -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:xerboxion.org</string>
		<string>webcredentials:xerboxion.org</string>
	</array>
	<key>com.apple.developer.homekit</key>
	<true/>
	<key>com.apple.developer.game-center</key>
	<true/>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>aps-environment</key>
	<string>production</string>
	<!-- 0.33 (RS-7 12.10 : « j'ai activé tous les trucs en plus ») : de retour, maintenant cochés sur l'identifiant de l'app -->
	<!-- le Wi-Fi d'un geste (jOSNatif.wifi : NEHotspotConfiguration l'exige) -->
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<!-- plus de mémoire : les gros ploxions (2 Mo de bundle) et plusieurs ouverts à la fois, sans que iOS tue l'app -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- les notifications de communication (un message de coord, avec qui l'envoie) -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
</dict>
</plist>
