<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Data Protection « Complete » : les fichiers de l'app (dont la base boxion_local) sont chiffrés par iOS quand l'iPhone est verrouillé -->
	<key>com.apple.developer.default-data-protection</key>
	<string>NSFileProtectionComplete</string>
	<!-- HealthKit (lecture, sur accord) -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<!-- NFC : lire des tags -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!-- le nom du réseau Wi-Fi -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<!-- App Groups : l'app et ses widgets partagent leurs données -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.ch.j0bot.ploxi0n</string>
	</array>
	<!-- Sign in with Apple : un compte bion (le serveur du labo vérifie le jeton d'Apple) -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
